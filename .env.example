# SQLAlchemy URL, async driver required
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sensors
# Uvicorn worker processes (fastapi run --workers)
WORKERS=2
# Per-worker pool: WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay < Postgres max_connections (100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5
# Seconds to wait for a free pool connection before answering 503
DB_POOL_TIMEOUT=5
# Postgres cancels any statement running longer than this (ms; 0 disables); answered as 503
DB_STATEMENT_TIMEOUT_MS=5000
# Postgres terminates sessions idle inside a transaction longer than this (ms; 0 disables)
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# Postgres gives up waiting for a lock after this (ms; 0 disables); answered as 503
DB_LOCK_TIMEOUT_MS=2000
# Compose only (API_PORT = host port for the API)
API_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sensors
